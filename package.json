{
  "name": "vite-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --mode=production",
    "dev": "vite --mode=development",
    "lint": "npm run lint:eslint && npm run lint:tsc && npm run lint:vuets",
    "lint:eslint": "eslint src tests",
    "lint:eslint:quiet": "eslint --quiet \"{tests,src}/**/*.{js,ts,tsx,vue}\"",
    "lint:fix": "eslint src tests --fix",
    "lint:tsc": "tsc -p ./tsconfig.json --noEmit && tsc -p ./tests/tsconfig.json --noEmit && tsc -p ./src/tsconfig.json --noEmit",
    "lint:vuets": "vue-tsc --noEmit -p ./src/tsconfig.json",
    "prepare": "husky",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "vite": "^7.1.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@stylistic/eslint-plugin": "^3.1.0",
    "@types/node": "^24.2.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "@vitejs/plugin-vue-jsx": "^5.0.1",
    "@vue/compiler-sfc": "^3.5.18",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.32.0",
    "eslint-config-airbnb-extended": "^2.1.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-n": "^17.21.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.5"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  }
}
